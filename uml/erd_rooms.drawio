<mxfile host="app.diagrams.net" modified="2026-11-21T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="rooms-erd" name="Room Management ERD"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Increment 2  |  Room Management ERD" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="64" y="38" width="900" height="45" as="geometry" /></mxCell><mxCell id="sub" value="FR-RM-01–05  ·  Proposed PostgreSQL schema  ·  No room assigned at booking time" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#566A7B;" vertex="1" parent="1"><mxGeometry x="64" y="84" width="980" height="26" as="geometry" /></mxCell><mxCell id="rt" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B8BA5;strokeWidth=1.7;arcSize=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="75" y="177" width="436" height="320" as="geometry" /></mxCell><mxCell id="rt-head" value="ROOM_TYPE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#174B73;strokeColor=#174B73;fontColor=#FFFFFF;fontSize=19;fontStyle=1;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="76" y="178" width="434" height="51" as="geometry" /></mxCell><mxCell id="rt-row-0" value="&lt;div style=&quot;font-family:Arial;font-size:14px;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#207097&quot;&gt;PK&lt;/font&gt;&lt;/b&gt;&amp;nbsp; &lt;b&gt;room_type_id&lt;/b&gt; &lt;font color=&quot;#547086&quot;&gt;UUID&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#667987&quot; style=&quot;font-size:12px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Primary key&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=non
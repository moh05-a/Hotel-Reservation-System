D&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#667987&quot; style=&quot;font-size:12px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; References ROOM_TYPE(room_type_id)&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=13;" vertex="1" parent="1"><mxGeometry x="659" y="265" width="438" height="51" as="geometry" /></mxCell><mxCell id="room-row-2" value="&lt;div style=&quot;font-family:Arial;font-size:14px;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#207097&quot;&gt;UQ&lt;/font&gt;&lt;/b&gt;&amp;nbsp; &lt;b&gt;room_number&lt;/b&gt; &lt;font color=&quot;#547086&quot;&gt;VARCHAR(20)&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#667987&quot; style=&quot;font-size:12px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Required; unique within hotel&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=13;" vertex="1" parent="1"><mxGeometry x="659" y="316" width="438" height="51" as="geometry" /></mxCell><mxCell id="room-row-3" value="&lt;div style=&quot;font-family:Arial;font-size:14px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;is_active&lt;/b&gt; &lt;font color=&quot;#547086&quot;&gt;BOOLEAN&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#667987&quot; style=&quot;font-size:12px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Required; defaults to TRUE&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=13;" vertex="1" parent="1"><mxGeometry x="659" y="367" width="438" height="51" as="geometry" /></mxCell><mxCell id="room-row-4" value="&lt;div style=&quot;font-family:Arial;font-size:14px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;cleaning_status&lt;/b&gt; &lt;font color=&quot;#547086&quot;&gt;VARCHAR(20)&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#667987&quot; style=&quot;font-size:12px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; CLEAN / DIRTY / INSPECTED&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=13;" vertex="1" parent="1"><mxGeometry x="659" y="418" width="438" height="51" as="geometry" /></mxCell><mxCell id="room-row-5" value="&lt;div style=&quot;font-family:Arial;font-size:14px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;operational_status&lt;/b&gt; &lt;font color=&quot;#547086&quot;&gt;VARCHAR(20)&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#667987&quot; style=&quot;font-size:12px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; IN_SERVICE / OUT_OF_ORDER&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=13;" vertex="1" parent="1"><mxGeometry x="659" y="469" width="438" height="51" as="geometry" /></mxCell><mxCell id="type-to-room" value="contains" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;startArrow=none;strokeColor=#286A96;strokeWidth=2;fontSize=13;fontColor=#265775;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rt" target="room"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="one" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#174B73;" vertex="1" parent="1"><mxGeometry x="523" y="293" width="33" height="26" as="geometry" /></mxCell><mxCell id="many" value="0..*" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#174B73;" vertex="1" parent="1"><mxGeometry x="603" y="293" width="50" height="26" as="geometry" /></mxCell><mxCell id="foot1" value="&lt;b&gt;Relationship:&lt;/b&gt; One ROOM_TYPE has zero or more ROOM records; every ROOM references exactly one ROOM_TYPE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF4FA;strokeColor=#C6D9E8;fontSize=14;fontColor=#27475E;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="76" y="576" width="1029" height="62" as="geometry" /></mxCell><mxCell id="foot2" value="&lt;b&gt;Constraints:&lt;/b&gt; max_guests &amp;gt; 0  ·  nightly_rate &amp;gt;= 0  ·  unique room_number  ·  valid room_type_id  ·  block unsafe deletion/deactivation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#D9E3EC;fontSize=13;fontColor=#526579;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="76" y="655" width="1029" height="66" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Design note:&lt;/b&gt; Cleaning and operational statuses are modeled separately, pending coordination with Housekeeping (Increment 9). Reservation holds and future Out-of-Order dates are designed in later increments." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9EE;strokeColor=#E9D8B2;fontSize=13;fontColor=#665334;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="76" y="737" width="1029" height="65" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>